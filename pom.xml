<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- Same Boot version as your ragspringai project -->
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>beans-demo</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>beans-demo</name>
    <description>Minimal app to inspect beans and the ApplicationContext via Actuator</description>

    <properties>
        <java.version>26</java.version>
    </properties>

    <dependencies>
        <!-- Spring MVC + embedded Tomcat. In Boot 4 this replaces spring-boot-starter-web
             (the old name still exists as a deprecated alias if this one doesn't resolve). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>


    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
